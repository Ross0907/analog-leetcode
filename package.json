{
  "name": "anacode",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run audit:simulator && npm run test:unit && node --import tsx --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "audit:simulator": "node scripts/audit-simulator-provenance.mjs && node scripts/audit-circuitjs.mjs && node scripts/audit-kicad-symbols.mjs && node scripts/build-kicad-presentation.mjs --check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@spice-ts/core": "0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tisoap/react-flow-smart-edge": "5.0.0",
    "@xyflow/react": "12.11.6",
    "drizzle-orm": "0.45.2",
    "eecircuit-engine": "file:vendor/eecircuit-engine",
    "fft.js": "4.0.4",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/workers-types": "5.20260915.1",
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fflate": "0.8.3"
  },
  "type": "module",
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true
  }
}
